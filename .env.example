# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Auth (basic, optional - if set, enables login) ────────────────────────
# Leave both empty to disable auth (not recommended for exposed instances)
AUTH_USERNAME=
AUTH_PASSWORD=

# ─── Database ───────────────────────────────────────────────────────────────
DB_PATH=/data/groovarr.db
# Optional: DB_SALT for future encryption features
DB_SALT=

# ─── All other configuration is stored in the database and managed via the web UI ──
# After first login, go to Settings page to configure:
#   - Discord bot token & permissions
#   - Lidarr connection details
#   - Popularity thresholds
#   - Download modes
#   - Scheduler timing
#   - etc.