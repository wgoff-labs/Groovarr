# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Auth (basic, change in prod) ────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# ─── Discord (optional) ──────────────────────────────────────────────────────
DISCORD_TOKEN=
REPORT_CHANNEL_ID=0
COMMAND_PREFIX=?
AUTO_THREAD_ARCHIVE=10080

# ─── Popularity ───────────────────────────────────────────────────────────────
POPULARITY_THRESHOLD=60
LASTFM_API_KEY=

# ─── Lidarr ──────────────────────────────────────────────────────────────────
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=
LIDARR_QUALITY_PROFILE=Standard
LIDARR_ROOT_FOLDER=

# ─── Scheduler ───────────────────────────────────────────────────────────────
DOWNLOAD_MODE=tracks
DAILY_CHECK_CRON=0 9 * * *
TIMEZONE=America/Detroit

# ─── Database ────────────────────────────────────────────────────────────────
DB_PATH=/data/watchlist.db
